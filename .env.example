# DOM IP Scanner — Environment Configuration Template

# HTTP Server Port
PORT=7890

# Node Environment ('development' | 'production')
NODE_ENV=production

# JWT Authentication Secret Key (Required for User & Guest Token Signing)
JWT_SECRET=super_secret_jwt_key_dom_scanner_2026_change_in_production

# Optional External Cloud URL (e.g., Render deployment URL)
RENDER_EXTERNAL_URL=https://ipscaner.onrender.com

# Database File Path (Defaults to local domscanner.db or /tmp/domscanner.db on Render)
DATABASE_PATH=./domscanner.db
